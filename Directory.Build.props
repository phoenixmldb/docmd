<Project>
  <PropertyGroup>
    <!-- net10.0 always; net11.0 whenever the SDK can build it. global.json pins SDK 11, so a
         normal build produces all of them. CI's build-sdk10 job builds with SDK 10, which
         yields net10.0 alone and proves those builds need nothing from SDK 11. SDK 10
         leaves NETCoreSdkVersion empty this early, which therefore reads as "not 11".
         TargetNet11 is reused by projects that set their own TargetFrameworks. -->
    <TargetNet11 Condition="'$(NETCoreSdkVersion)' != '' and $([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">true</TargetNet11>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetNet11)' == 'true'">$(TargetFrameworks);net11.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-all</AnalysisLevel>
  </PropertyGroup>
  <PropertyGroup>
    <!--
      One version for the whole product. 0.x is deliberate: docmd converts real documents well
      (43 of 49 in the reference corpus lose not one word) but several advertised flags are not
      implemented yet, and 1.0 is a promise about stability that should be made once rather than
      taken back. It also leaves room to change the md-XML vocabulary, which a custom stylesheet
      depends on.
    -->
    <Version>0.3.0</Version>
    <Authors>Endpoint Systems</Authors>
    <Company>Endpoint Systems</Company>
    <Product>docmd</Product>
    <!-- Not "all rights reserved": docmd's core is Apache-2.0, and that boilerplate
         contradicts the licence it ships under. -->
    <Copyright>Copyright © Endpoint Systems 2026</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <!--
      phoenixmldb, not endpointsystems: docmd is a consumer of the PhoenixmlDb engines and
      belongs beside them and beside crucible, which is the same shape of tool. These two
      values are embedded in the published package, so they had to be right before the first
      push to nuget.org rather than corrected afterwards.
    -->
    <RepositoryUrl>https://github.com/phoenixmldb/docmd</RepositoryUrl>
    <PackageProjectUrl>https://github.com/phoenixmldb/docmd</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <!--
    Test projects are executables under Microsoft.Testing.Platform: a test assembly is its own
    runner, so there is no external host to load it. xunit.v3 4.x fails the build without this
    rather than inferring it, which is the right call but does mean it has to be said somewhere.

    Here rather than in each csproj so a test project added later cannot quietly miss it. The
    condition matches on the project name because IsTestProject is set by the test SDK targets,
    which are imported long after Directory.Build.props is evaluated: conditioning on it here
    would silently never match.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Deterministic in every configuration, not just Release: docmd's own output
       determinism is a product guarantee, and a non-deterministic build is a
       confusing thing to debug underneath it. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
</Project>
